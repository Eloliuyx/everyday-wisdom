{
  "name": "everyday-wisdom",
  "version": "1.0.0",
  "description": "One thoughtful reflection for each date in your Daily Notes, entirely offline.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node esbuild.config.mjs --watch",
    "build": "npm run typecheck && npm run qa:content && node esbuild.config.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src",
    "qa:content": "node scripts/content-qa.mjs",
    "check": "npm run lint && npm test && npm run build",
    "package": "npm run check && node scripts/package.mjs",
    "test:vault": "node scripts/create-test-vault.mjs"
  },
  "author": "the flying markhor",
  "license": "MIT",
  "dependencies": {
    "obsidian-daily-notes-interface": "0.9.5"
  },
  "devDependencies": {
    "@codemirror/state": "6.5.0",
    "@codemirror/view": "6.38.6",
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "eslint": "^10.11.0",
    "eslint-plugin-obsidianmd": "0.4.2",
    "jiti": "^2.6.0",
    "obsidian": "1.13.1",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  }
}
